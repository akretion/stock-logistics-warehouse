<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="action_report_count_sheet" model="ir.actions.report">
        <field name="name">Count Sheet</field>
        <field name="model">stock.inventory.count.round</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >stock_inventory_multi_count.report_count_sheet</field>
        <field
            name="report_file"
        >stock_inventory_multi_count.report_count_sheet</field>
        <field name="binding_model_id" ref="model_stock_inventory_count_round" />
        <field name="binding_type">report</field>
        <field
            name="print_report_name"
        >'Count Sheet - %s' % (object.name or '').replace('/', '-')</field>
    </record>

</odoo>
