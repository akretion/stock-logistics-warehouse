<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="stock_inventory_count_arbitrate_view_form" model="ir.ui.view">
        <field name="name">stock.inventory.count.arbitrate.form</field>
        <field name="model">stock.inventory.count.arbitrate</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert">
                    Arbitration overrides independent physical counts. It is recorded
                    with your name and your justification on every line.
                </div>
                <group>
                    <field name="line_count" readonly="1" string="Lines to arbitrate" />
                    <field name="resolution" widget="radio" />
                    <field
                        name="manual_qty"
                        attrs="{'invisible': [('resolution', '!=', 'manual')], 'required': [('resolution', '=', 'manual')]}"
                    />
                    <field name="note" placeholder="Why this quantity was chosen" />
                </group>
                <field name="line_ids" invisible="1" />
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Arbitrate and Apply"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
